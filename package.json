{
  "name": "codex-dsh-bridge-companion",
  "version": "0.3.0",
  "type": "module",
  "description": "DeepSeek Harness companion for the Codex DSH Bridge.",
  "main": "./dsh-plugin/lib/index.js",
  "exports": {
    ".": "./dsh-plugin/lib/index.js",
    "./client": "./dsh-plugin/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin/lib",
    "dsh-plugin/cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs dsh-plugin/tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/knottttt/codex-dsh-bridge.git"
  },
  "keywords": [
    "codex",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "mcp"
  ]
}
